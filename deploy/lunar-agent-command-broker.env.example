LUNAR_AGENT_COMMAND_BROKER_TOKEN=
LUNAR_AGENT_COMMAND_WORKSPACE_ROOT=/var/lib/lunar-agent/workspaces
LUNAR_AGENT_COMMAND_WORKSPACE_TTL_SECONDS=86400
LUNAR_AGENT_COMMAND_WORKSPACE_CLEANUP_INTERVAL_SECONDS=300
LUNAR_AGENT_BWRAP_BINARY=/opt/lunar-agent-command-broker/bin/bwrap
LUNAR_AGENT_PRLIMIT_BINARY=/usr/bin/prlimit
