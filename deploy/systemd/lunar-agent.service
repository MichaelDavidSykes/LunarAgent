[Unit]
Description=LunarAgent private reasoning service
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=/etc/lunarengine-prefect.env
Environment=LUNAR_AGENT_MODEL=gpt-5
Environment=LUNAR_AGENT_WEB_RESEARCH_ENABLED=true
Environment=LUNAR_AGENT_WEB_SEARCH_CONTEXT_SIZE=medium
Environment=LUNAR_AGENT_WEB_REASONING_EFFORT=low
Environment=LUNAR_AGENT_WEB_MAX_OUTPUT_TOKENS=1000
Environment=LUNAR_AGENT_AREA_RISK_MODEL=gpt-5-mini
Environment=LUNAR_AGENT_AREA_RISK_WEB_RESEARCH_ENABLED=false
Environment=LUNAR_AGENT_AREA_RISK_SEARCH_CONTEXT_SIZE=medium
Environment=LUNAR_AGENT_AREA_RISK_REASONING_EFFORT=low
Environment=LUNAR_AGENT_AREA_RISK_MAX_OUTPUT_TOKENS=700
Environment=LUNAR_AGENT_AREA_RISK_MAX_EVIDENCE_ITEMS=12
Environment=LUNAR_AGENT_AREA_RISK_MAX_ZONES=6
Environment=LUNAR_AGENT_AREA_RISK_FALLBACK_ON_EMPTY_WEB=false
ExecStartPre=-/usr/bin/docker rm -f lunar-agent
ExecStart=/usr/bin/docker run --rm \
  --name lunar-agent \
  --env-file /etc/lunarengine-prefect.env \
  --env LUNAR_AGENT_MODEL=gpt-5 \
  --env LUNAR_AGENT_WEB_RESEARCH_ENABLED=true \
  --env LUNAR_AGENT_WEB_SEARCH_CONTEXT_SIZE=medium \
  --env LUNAR_AGENT_WEB_REASONING_EFFORT=low \
  --env LUNAR_AGENT_WEB_MAX_OUTPUT_TOKENS=1000 \
  --env LUNAR_AGENT_AREA_RISK_MODEL \
  --env LUNAR_AGENT_AREA_RISK_WEB_RESEARCH_ENABLED \
  --env LUNAR_AGENT_AREA_RISK_SEARCH_CONTEXT_SIZE \
  --env LUNAR_AGENT_AREA_RISK_REASONING_EFFORT \
  --env LUNAR_AGENT_AREA_RISK_MAX_OUTPUT_TOKENS \
  --env LUNAR_AGENT_AREA_RISK_MAX_EVIDENCE_ITEMS \
  --env LUNAR_AGENT_AREA_RISK_MAX_ZONES \
  --env LUNAR_AGENT_AREA_RISK_FALLBACK_ON_EMPTY_WEB \
  --publish 127.0.0.1:8310:8310 \
  --publish 172.17.0.1:8310:8310 \
  --security-opt no-new-privileges \
  --tmpfs /tmp:rw,noexec,nosuid,size=64m \
  lunar-agent:latest
ExecStop=/usr/bin/docker stop lunar-agent
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
