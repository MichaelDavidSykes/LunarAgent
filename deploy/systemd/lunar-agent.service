[Unit]
Description=LunarAgent private reasoning service
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=/etc/lunarengine-prefect.env
Environment=LUNAR_AGENT_MODEL=gpt-5.1
Environment=LUNAR_AGENT_WEB_RESEARCH_ENABLED=true
Environment=LUNAR_AGENT_WEB_SEARCH_CONTEXT_SIZE=medium
Environment=LUNAR_AGENT_WEB_REASONING_EFFORT=low
Environment=LUNAR_AGENT_WEB_MAX_OUTPUT_TOKENS=1000
Environment=LUNAR_AGENT_CHAT_REASONING_EFFORT=low
Environment=LUNAR_AGENT_AREA_RISK_PROVIDER_MODE=chatgpt-account
Environment=LUNAR_AGENT_AREA_RISK_MODEL=gpt-5.1
Environment=LUNAR_AGENT_AREA_RISK_WEB_RESEARCH_ENABLED=true
Environment=LUNAR_AGENT_AREA_RISK_SEARCH_CONTEXT_SIZE=medium
Environment=LUNAR_AGENT_AREA_RISK_REASONING_EFFORT=low
Environment=LUNAR_AGENT_AREA_RISK_MAX_OUTPUT_TOKENS=700
Environment=LUNAR_AGENT_AREA_RISK_MAX_EVIDENCE_ITEMS=12
Environment=LUNAR_AGENT_AREA_RISK_MAX_ZONES=6
Environment=LUNAR_AGENT_AREA_RISK_FALLBACK_ON_EMPTY_WEB=false
Environment=LUNAR_AGENT_AREA_RISK_ACCOUNT_ENABLED=true
Environment=LUNAR_AGENT_AREA_RISK_CODEX_MODEL=gpt-5.6-sol
Environment=LUNAR_AGENT_AREA_RISK_CODEX_REASONING_EFFORT=low
Environment=LUNAR_AGENT_AREA_RISK_CODEX_TIMEOUT=180
Environment=LUNAR_AGENT_CODEX_ENABLED=true
Environment=LUNAR_AGENT_CODEX_MODEL=gpt-5.6-sol
Environment=LUNAR_AGENT_CODEX_REASONING_EFFORT=medium
Environment=LUNAR_AGENT_CODEX_TIMEOUT=900
Environment=LUNAR_AGENT_CODEX_MAX_CONCURRENT_REQUESTS=2
Environment=CODEX_HOME=/codex-auth
ExecStartPre=-/usr/bin/docker rm -f lunar-agent
ExecStart=/usr/bin/docker run --rm \
  --name lunar-agent \
  --env-file /etc/lunarengine-prefect.env \
  --env LUNAR_AGENT_MODEL=gpt-5.1 \
  --env LUNAR_AGENT_WEB_RESEARCH_ENABLED=true \
  --env LUNAR_AGENT_WEB_SEARCH_CONTEXT_SIZE=medium \
  --env LUNAR_AGENT_WEB_REASONING_EFFORT=low \
  --env LUNAR_AGENT_WEB_MAX_OUTPUT_TOKENS=1000 \
  --env LUNAR_AGENT_CHAT_REASONING_EFFORT=low \
  --env LUNAR_AGENT_AREA_RISK_PROVIDER_MODE \
  --env LUNAR_AGENT_AREA_RISK_MODEL=gpt-5.1 \
  --env LUNAR_AGENT_AREA_RISK_WEB_RESEARCH_ENABLED \
  --env LUNAR_AGENT_AREA_RISK_SEARCH_CONTEXT_SIZE \
  --env LUNAR_AGENT_AREA_RISK_REASONING_EFFORT \
  --env LUNAR_AGENT_AREA_RISK_MAX_OUTPUT_TOKENS \
  --env LUNAR_AGENT_AREA_RISK_MAX_EVIDENCE_ITEMS \
  --env LUNAR_AGENT_AREA_RISK_MAX_ZONES \
  --env LUNAR_AGENT_AREA_RISK_FALLBACK_ON_EMPTY_WEB \
  --env LUNAR_AGENT_AREA_RISK_ACCOUNT_ENABLED \
  --env LUNAR_AGENT_AREA_RISK_CODEX_MODEL \
  --env LUNAR_AGENT_AREA_RISK_CODEX_REASONING_EFFORT \
  --env LUNAR_AGENT_AREA_RISK_CODEX_TIMEOUT \
  --env LUNAR_AGENT_CODEX_ENABLED \
  --env LUNAR_AGENT_CODEX_MODEL \
  --env LUNAR_AGENT_CODEX_REASONING_EFFORT \
  --env LUNAR_AGENT_CODEX_TIMEOUT \
  --env LUNAR_AGENT_CODEX_MAX_CONCURRENT_REQUESTS \
  --env CODEX_HOME \
  --volume /etc/lunar-agent/codex:/codex-auth:rw \
  --publish 127.0.0.1:8310:8310 \
  --publish 172.17.0.1:8310:8310 \
  --security-opt no-new-privileges \
  --cap-drop ALL \
  --read-only \
  --memory 1536m \
  --cpus 4 \
  --pids-limit 256 \
  --tmpfs /tmp:rw,exec,nosuid,size=512m \
  lunar-agent:latest
ExecStop=/usr/bin/docker stop lunar-agent
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
